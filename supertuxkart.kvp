Meta.DisplayName=SuperTuxKart (TeamKit)
Meta.Description=Serveur de SuperTuxKart, la course de karts libre et gratuite : le binaire Linux OFFICIEL (GitHub supertuxkart/stk-code), meme version que les joueurs (derniere stable a chaque Update, 1.5 au 10/10/2026), lance sans affichage avec --server-config. Course, contre-la-montre, grand prix, bataille, capture du drapeau, football. Liste publique officielle avec un compte STK gratuit, sinon joignable par IP:port. Port 2759 en UDP (+ 2757 en UDP pour la decouverte). Joueurs visibles dans AMP, console d'AMP branchee sur la console reseau du jeu (listpeers, kick, quit).
Meta.OS=Linux
Meta.Arch=x86_64
Meta.AarchSupport=NotSupported
Meta.Author=TeamKit
Meta.URL=https://github.com/hydrocut/AMPTemplates-SuperTuxKart
Meta.DisplayImageSource=url:https://raw.githubusercontent.com/supertuxkart/stk-code/master/data/supertuxkart_256.png
Meta.EndpointURIFormat=
Meta.ConfigManifest=supertuxkartconfig.json
Meta.MetaConfigManifest=supertuxkartmetaconfig.json
Meta.ConfigRoot=supertuxkart.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=True
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Required
Meta.ContainerPolicyReason=Teste uniquement dans l'image cubecoders/ampbase:debian (Debian 13) : python3 et curl y sont garantis par ExtraContainerPackages. Le binaire officiel apporte ses propres bibliotheques (dossier lib/), il ne demande que la glibc.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["python3","curl"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=c7d60b6d-8671-49d1-ab9f-3dbc083325dd
Meta.ImportableExtensions=[]
